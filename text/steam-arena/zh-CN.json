  "values": {
    "dom:main::screen:arena::div#app/main#screen/div.arena.px-ui:n1/section.ar-board.px-sk:n1/div.ch-list:n1/button:key:arena%3Acamp%3A0%2C0/span.who:n3::text:0": "",
    "dom:main::screen:garage::div#app/main#screen/div.ed:n1/div.ed-main:n1/div.ed-dock:n2/div.dock-ctx:n1/div.info:n1/div.sub:n2::text:0": "左键放置模块；右键取消",
    "story:opening": "[{\"text\":\"你正在睡觉，伦敦的春季酷烈无情，冷风像一颗颗钉子从门缝吹进来。你像无数普通人一样背井离乡，身无分文。\",\"scene\":\"sleep\"},{\"text\":\"就在你于梦中探寻着家中的厨房时，你的窝棚门突然被打开了——\",\"scene\":\"roof\"},{\"text\":\"许久未见的远房亲戚滚了进来……还有你的房东铁匠。\",\"scene\":\"roll\"},{\"text\":\"为了女皇的寿辰！现在继承我的战车，赢取荣耀吧！\",\"who\":\"uncle\",\"scene\":\"car\"},{\"text\":\"……和奖金！\",\"who\":\"smith\"}]",
    "story:tutorial.intro": "[{\"text\":\"女皇的寿辰在即，十年一遇的大竞技赛就要开始了。我们得抓紧时间训练，好在生日宴那天出现在竞技场上。\",\"who\":\"uncle\"},{\"text\":\"我给你找来了我的徒弟提米对练，小心别把他打伤了！\",\"who\":\"smith\"}]",
    "story:tutorial.parts.0": "[{\"text\":\"驾驶舱：一切的核心，就像心脏。失去了它你就输了。\",\"who\":\"uncle\"}]",
    "story:tutorial.parts.1": "[{\"text\":\"履带：本世纪最好的发明。\"},{\"text\":\"……上个世纪的。\",\"who\":\"smith\"}]",
    "story:tutorial.parts.2": "[{\"text\":\"锅炉：一切的核心，就像心脏。失去了它你就输了。\",\"who\":\"uncle\"},{\"text\":\"……我刚刚是不是这么说过？\",\"who\":\"uncle\"}]",
    "story:tutorial.parts.3": "[{\"text\":\"机枪：别担心，这是训练用弹！\"},{\"text\":\"只是打在身上……会有点疼。\",\"who\":\"smith\"}]",
    "home:chat:pool:stage:0:1": "[]",
    "home:chat:settings": "{\"intervalSec\":6,\"bubbleSec\":6,\"replySec\":3.3}",
    "home:chat:pool:stage:0:0": "[]",
    "home:chat:pool:chapter:0": "[]",
    "home:chat:pool:global": "[]",
    "story:before.0,2": "[{\"text\":\"哦——老家伙，你的小朋友还真是有两把刷子，这回该换我上场了！\",\"who\":\"smith\"}]",
    "story:stage.0,0.win": "[]",
    "story:stage.0,0.lose": "[]",
    "story:stage.0,1.win": "[]",
    "story:feat.garage": "[{\"text\":\"你现在可以使用车间了，为了大不列颠女皇的荣耀！\",\"who\":\"uncle\"},{\"text\":\"我们得有一辆好车。\",\"who\":\"uncle\"},{\"text\":\"所以你的车为什么这么破？\",\"who\":\"smith\"},{\"text\":\"说来话长……说来话长……\",\"who\":\"uncle\"}]",
    "story:feat.shop": "[{\"text\":\"商店开张了：你可以从汤姆那里直接买到新零件，当然要付钱……\",\"who\":\"uncle\"},{\"text\":\"真是个吝啬鬼（小声）\",\"who\":\"uncle\"},{\"text\":\"你还欠着我的钱呢！\",\"who\":\"smith\"}]",
    "story:feat.street": "[]",
    "story:feat.bank": "[{\"text\":\"哦！看看这是什么？伦敦银行的开户信息，现在你可以借钱了！\",\"who\":\"uncle\"},{\"text\":\"那我的欠款……\",\"who\":\"smith\"},{\"text\":\"哦！瞧我这记性，该去喝酒了！\",\"who\":\"uncle\"}]",
    "story:stage.0,2.win": "[]",
    "story:stage.0,2.lose": "[]",
    "story:stage.0,1.lose": "[]",
    "story:feat.upgrade": "[]",
    "story:feat.blueprints": "[]",
    "story:feat.bet": "[]",
    "story:feat.orders": "[]",
    "story:feat.friendly": "[]",
    "story:feat.season": "[]",
    "story:after.0,0": "[{\"text\":\"哦看看我忘记了什么，水罐！虽说没有水也能运行一阵子，时间久了锅炉会把你烤熟的！就像我在孟买的那次……\",\"who\":\"uncle\"},{\"text\":\"老朋友……你的破车为什么连水罐都没有就开过来了？\",\"who\":\"smith\"},{\"text\":\"你的车也没有水罐啊！\",\"who\":\"uncle\"},{\"text\":\"那是我徒弟的车，他才刚刚开始学呢！\",\"who\":\"smith\"}]",
    "dom:main::screen:garage::div#modal/div.panel:n1/div.panel-body:n2/div.help:n1/p:n1::text:0": "1. 从模块清单选择模块，移动到格子上使用左键放置。",
    "dom:main::screen:garage::div#modal/div.panel:n1/div.panel-body:n2/div.help:n1/p:n2::text:0": "2. 选中时，使用右键取消当前操作。",
    "story:before.0,1": "[{\"text\":\"我刚替你看了看，除了水罐，汤姆还给车上加了额外的甲片！真是卑鄙！这不公平！\",\"who\":\"uncle\"},{\"text\":\"你怎么还来偷看！作弊的老东西！\",\"who\":\"smith\"},{\"text\":\"你要想办法打掉他的武器，只要没有武器你就算赢了！\",\"who\":\"uncle\"},{\"text\":\"这不公平！\",\"who\":\"smith\"}]",
    "dom:main::screen:arena::div#modal/div.panel.dialog:n1/div.panel-body:n2/div.salvage:n1/div.dlg-item:n1/div:n1/div.muted:n1::text:0": "耐久 260 · 装甲厚度 5 · 重量 0.70 t "
  },
